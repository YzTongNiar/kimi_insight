  # ---------- 节点文字 ----------
  - elementId: t-select
    elementType: text
    bounds: [41, 124, 138, 60]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#1D4ED8"><strong>verify：选择 checkpoint</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">按 prev accepted−1 取 \(S_0\)</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">从原生 slot index_select</span></p>
  - elementId: t-verify
    elementType: text
    bounds: [226, 124, 138, 60]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#1D4ED8"><strong>verify：逐 token 递推</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">\(S_t=S_{t-1}D_t+u_t\hat{k}^{\mathsf{T}}\)</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">\(y_t=S_t\hat{q}\)；S₀ 只读不改</span></p>
  - elementId: t-sample
    elementType: text
    bounds: [411, 124, 138, 60]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#C2410C"><strong>RejectionSampler</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">拒绝采样，确定接受长度 n</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">n=(ids≥0).sum 含 bonus</span></p>
  - elementId: t-commit
    elementType: text
    bounds: [596, 124, 138, 60]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#1D4ED8"><strong>commit：重建 \(S_{\mathrm{rebuilt}}\)</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">\(U\leftarrow U+u_t\hat{k}^{\mathsf{T}}P,\ P\leftarrow D_tP\)</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">t=n…1 反向，仅已接受前缀</span></p>
  - elementId: t-prev
    elementType: text
    bounds: [41, 254, 138, 60]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#6D28D9"><strong>原生 state 槽位</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">已提交 checkpoint \(S_0\)</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">每槽位 H×V×K 矩阵</span></p>
  - elementId: t-records
    elementType: text
    bounds: [226, 254, 138, 60]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#6D28D9"><strong>存储向量记录 R_t</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">\(R_t=(u_t,\ k_t,\ g^{\mathrm{raw}}_t)\)</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">pending：仅本同步步有效</span></p>
  - elementId: t-mirror
    elementType: text
    bounds: [596, 254, 138, 60]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#6D28D9"><strong>更新 recurrent state</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">\(S_{\mathrm{rebuilt}}\) 写回原生 slot</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">镜像全部槽位，释放 R_t</span></p>
  - elementId: t-next
    elementType: text
    bounds: [781, 254, 138, 60]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#6D28D9"><strong>下一轮 verify</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">以 \(S_{\mathrm{rebuilt}}\) 为新 \(S_0\)</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">沿用原生复制/索引契约</span></p>
  - elementId: t-draft
    elementType: text
    bounds: [781, 380, 138, 54]
    content:
      align: [center, middle]
      lineHeight: 1.25
      text: |
        <p style="text-align:center"><span style="font-size:10px; color:#047857"><strong>草稿模型前向</strong></span></p>
        <p style="text-align:center; margin-top:3px"><span style="font-size:8px; color:$text">commit 完成后才起草</span></p>
        <p style="text-align:center; margin-top:2px"><span style="font-size:8px; color:$muted">产出下一轮候选 token</span></p>

